# Supabase（豆友の投稿とアカウント）。未設定なら投稿は端末内にだけ保存される。
# 値は Supabase ダッシュボード > Project Settings > API から取得する。
# anon key は公開前提のキー。service_role キーは絶対にここへ書かない。
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 任意: 投稿の AI 判定（OpenAI 互換の moderation エンドポイント）。
# ブラウザにキーが載るため、公開ビルドでは設定しない（Edge Function 経由にする）。
VITE_MODERATION_ENDPOINT=
VITE_MODERATION_MODEL=omni-moderation-latest
VITE_MODERATION_API_KEY=
